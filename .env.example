PLATEPROOF_ENV=development
PLATEPROOF_DATA_DIR=data
PLATEPROOF_DATABASE_PATH=data/processed/plateproof.duckdb
# Task 10: link-only Google Maps feature (a plain outbound search URL --
# no API key, no billing account, no OAuth; see README.md).
PLATEPROOF_GOOGLE_INTEGRATION_ENABLED=false
PLATEPROOF_LOCAL_LLM_ENABLED=false
# Only http://localhost:<port> or http://127.0.0.1:<port> are ever accepted (SSRF boundary).
PLATEPROOF_LOCAL_LLM_BASE_URL=http://localhost:11434
# Required (in addition to LOCAL_LLM_ENABLED=true) for local intent assistance to activate.
PLATEPROOF_LOCAL_LLM_MODEL=
# Task 8B: bounded local-model request behavior (seconds/bytes).
PLATEPROOF_LOCAL_LLM_CONNECT_TIMEOUT_SECONDS=2.0
PLATEPROOF_LOCAL_LLM_READ_TIMEOUT_SECONDS=5.0
PLATEPROOF_LOCAL_LLM_MAX_RESPONSE_BYTES=65536
PLATEPROOF_LOCAL_LLM_MIN_CONFIDENCE=0.6
# Task 8B: Copilot question length bound (used by the API, service, and UI).
PLATEPROOF_COPILOT_MAX_QUESTION_LENGTH=500
# Task 8B: path to the reviewed official-guidance corpus manifest.
PLATEPROOF_GUIDANCE_CORPUS_MANIFEST_PATH=data/reference/guidance/manifest.json
